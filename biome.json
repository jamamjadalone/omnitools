{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noInnerDeclarations": "off"
			},
			"suspicious": {
				"noThenProperty": "off",
				"useIterableCallbackReturn": "off",
				"noRedeclare": "off",
				"noAssignInExpressions": "off"
			},
			"a11y": {
				"recommended": false
			}
		}
	},
	"files": {
		"includes": ["**", "!**/assets/js/vendor/**"]
	}
}
