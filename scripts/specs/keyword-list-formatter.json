  "faq": [
    {
      "q": "What counts as a duplicate?",
      "a": "Keywords are compared case-insensitively after trimming, so 'SEO' and 'seo' are treated as the same keyword and only one is kept."
    },
    {
      "q": "Can I export to CSV?",
      "a": "Yes. Choose the CSV format and the list downloads as a one-column file you can open in any spreadsheet."
    },
    {
      "q": "Will multi-word keywords be split?",
      "a": "No. Keywords are separated by the punctuation in your input (commas, newlines, tabs), so 'keyword research' stays as one keyword."
    },
    {
      "q": "Is my keyword data uploaded?",
      "a": "No. Formatting happens entirely in your browser."
