l\">\n      <h3 style=\"margin-bottom:12px;\">Generated .gitignore</h3>\n      <div class=\"output-box\" id=\"outputBox\" style=\"max-height:420px;\">Your .gitignore will appear here.</div>\n      <div class=\"copy-row\" style=\"justify-content:flex-start;margin-top:12px;\">\n        <button class=\"btn btn-secondary btn-sm\" id=\"copyBtn\">Copy</button>\n        <button class=\"btn btn-primary btn-sm\" id=\"downloadBtn\">Download .gitignore</button>\n      </div>\n    </div>\n  </div>",
